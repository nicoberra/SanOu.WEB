# ─── Meta Commerce AI — variables de entorno ─────────────────────────────
# Copiá este archivo a .env (NO se versiona) y completá solo lo que uses.
# Ninguna de estas claves llega al navegador: el panel habla solo con este servidor.

# Servidor
PORT=8787
# Token del administrador para el modo local (panel). Generalo con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Almacenamiento: "file" (local, demo) o "supabase" (producción)
STORE=file
DATA_DIR=.data
SUPABASE_URL=
# service_role: SOLO en el servidor/worker. Nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Para validar los JWT de usuarios del panel en producción (Supabase Auth)
SUPABASE_JWT_SECRET=

# Fuente del catálogo San Ou (lectura, sin modificar nada del e-commerce)
SANOU_SITE_URL=https://sanou.com.ar
# Backend público del sitio (Apps Script, acción "catalogo": devuelve solo columnas públicas)
SANOU_CATALOG_EXEC_URL=https://script.google.com/macros/s/AKfycbxMW0TTu37oiDySEaGgF--ZLXoz3JNEWhoHvzGViQ4vVQMJGX5AeIi-9C4IcY1Uc1P2/exec
# Si se define, lee las fichas desde el repo local en lugar de la web (desarrollo / demo sin red)
SANOU_LOCAL_REPO=..
# offline = no consulta precios/stock por red (usa la última instantánea o deja "desconocido")
SANOU_PRICES_MODE=online

# Sincronización (minutos)
CATALOG_SYNC_EVERY_MIN=30

# Integraciones con Meta: TODO apagado por defecto
META_GRAPH_VERSION=v26.0
META_WRITE_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
META_CATALOG_ID=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=

# Integración con la agencia (orquestador central): firma HMAC de las tareas
AGENCY_SHARED_SECRET=
AGENCY_CALLBACK_URL=

# IA (opcional). Sin proveedor configurado se usa el modo "offline" (plantillas, sin inventar datos).
AI_PROVIDER=offline
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Tope de gasto de IA por organización y día (USD)
AI_DAILY_BUDGET_USD=2
